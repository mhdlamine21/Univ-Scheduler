<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.DialogueCreneauControleur">
   
   <content>
      <VBox spacing="16" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 10;"
            prefWidth="600">
      
         <!-- Titre cours -->
         <Label fx:id="titreCours" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4361EE;" />
      
         <!-- Info heure pré-remplie -->
         <HBox spacing="12" style="-fx-background-color: #F8F9FF; -fx-padding: 10 14; -fx-background-radius: 7;">
            <Label text="📅" style="-fx-font-size: 16px;" />
            <VBox spacing="2">
               <Label fx:id="infoJourLabel" style="-fx-font-weight: bold; -fx-text-fill: #4361EE; -fx-font-size: 13px;" />
               <Label fx:id="infoHeureLabel" style="-fx-text-fill: #1A1F3A; -fx-font-size: 12px;" />
            </VBox>
         </HBox>
      
         <!-- Sélection du cours -->
         <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Cours :" style="-fx-font-weight: bold; -fx-text-fill: #1A1F3A; -fx-min-width: 70;" />
            <ComboBox fx:id="coursCombo" prefWidth="380" promptText="Sélectionner un cours..." 
                      style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5; -fx-background-radius: 5;" />
         </HBox>
      
         <!-- Durée -->
         <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Durée :" style="-fx-font-weight: bold; -fx-text-fill: #1A1F3A; -fx-min-width: 70;" />
            <Spinner fx:id="dureeSpinner" prefWidth="90" editable="false" 
                     style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
            <Label text="heure(s)  -  max 5h" style="-fx-text-fill: #7B83C4; -fx-font-size: 12px;" />
            <Label fx:id="heureFinLabel" style="-fx-text-fill: #4361EE; -fx-font-weight: bold; -fx-font-size: 13px;" />
         </HBox>
      
         <Separator />
      
         <!-- Mode attribution -->
         <VBox spacing="10">
            <Label text="Attribution de la salle" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1F3A;" />
            <HBox spacing="20">
               <RadioButton fx:id="modeManuelRadio" text="Manuel - je choisis la salle" selected="true" 
                            style="-fx-text-fill: #1A1F3A;" />
               <RadioButton fx:id="modeAutoRadio" text="Automatique - algorithme" 
                            style="-fx-text-fill: #1A1F3A;" />
            </HBox>
         
            <!-- PANNEAU MANUEL -->
            <VBox fx:id="panneauManuel" spacing="10"
                  style="-fx-background-color: #F8F9FF; -fx-padding: 12; -fx-background-radius: 7;">
               <HBox spacing="12" alignment="CENTER_LEFT">
                  <Label text="UFR :" style="-fx-font-weight: bold; -fx-min-width: 65; -fx-text-fill: #1A1F3A;" />
                  <ComboBox fx:id="ufrComboManuel" prefWidth="190" promptText="Toutes les UFR" 
                            style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
                  <Label text="Bâtiment :" style="-fx-font-weight: bold; -fx-text-fill: #1A1F3A;" />
                  <ComboBox fx:id="batimentComboManuel" prefWidth="190" promptText="Sélectionner..." 
                            style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
               </HBox>
               <HBox spacing="8" alignment="CENTER_LEFT">
                  <Label text="Salles disponibles :" style="-fx-font-weight: bold; -fx-text-fill: #1A1F3A;" />
                  <Label fx:id="nbSallesDispoLabel" style="-fx-text-fill: #2DC653; -fx-font-size: 12px;" />
               </HBox>
               <TableView fx:id="sallesManuelTable" prefHeight="250">
                  <columns>
                     <TableColumn fx:id="salleNumeroCol"   text="Salle"     prefWidth="75" />
                     <TableColumn fx:id="salleCapaciteCol" text="Capacité"  prefWidth="75" />
                     <TableColumn fx:id="salleTypeCol"     text="Type"      prefWidth="80" />
                     <TableColumn fx:id="salleBatimentCol" text="Bâtiment"  prefWidth="140" />
                     <TableColumn fx:id="salleEtageCol"    text="Étage"     prefWidth="55" />
                     <TableColumn fx:id="salleStatutCol"   text="Statut"    prefWidth="90" />
                  </columns>
                  <placeholder>
                     <Label text="Sélectionnez un bâtiment pour voir les salles"
                            style="-fx-text-fill: #7B83C4; -fx-font-size: 12px;" />
                  </placeholder>
               </TableView>
            </VBox>
         
            <!-- PANNEAU AUTOMATIQUE -->
            <VBox fx:id="panneauAuto" spacing="10" visible="false" managed="false"
                  style="-fx-background-color: #F8F9FF; -fx-padding: 12; -fx-background-radius: 7;">
               <Label text="Préférences pour la recherche automatique"
                      style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1A1F3A;" />
               <HBox spacing="12" alignment="CENTER_LEFT">
                  <CheckBox fx:id="filtreUfrCheck" text="UFR préférée :" style="-fx-text-fill: #1A1F3A;" />
                  <ComboBox fx:id="ufrComboAuto" prefWidth="175" promptText="Toutes" disable="true" 
                            style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
               </HBox>
               <HBox spacing="12" alignment="CENTER_LEFT">
                  <CheckBox fx:id="filtreBatimentCheck" text="Bâtiment préféré :" style="-fx-text-fill: #1A1F3A;" />
                  <ComboBox fx:id="batimentComboAuto" prefWidth="175" promptText="Tous" disable="true" 
                            style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
               </HBox>
               <HBox spacing="12" alignment="CENTER_LEFT">
                  <CheckBox fx:id="filtreTypeCheck" text="Type de salle :" style="-fx-text-fill: #1A1F3A;" />
                  <ComboBox fx:id="typeSalleCombo" prefWidth="150" promptText="Tous types" disable="true" 
                            style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
               </HBox>
               <Button fx:id="lancerRechercheAutoButton" text="🔍 Lancer la recherche automatique"
                       style="-fx-background-color: #4361EE; -fx-text-fill: white;
                              -fx-background-radius: 6; -fx-padding: 7 16; -fx-font-weight: bold; 
                              -fx-cursor: hand;" />
               <VBox fx:id="resultAutoPane" spacing="4" visible="false" managed="false">
                  <Label fx:id="salleAutoLabel"
                         style="-fx-font-size: 13px; -fx-text-fill: #2DC653; -fx-font-weight: bold;" />
                  <Label fx:id="salleAutoDetailLabel"
                         style="-fx-font-size: 11px; -fx-text-fill: #1A1F3A;" />
               </VBox>
         
               <!-- Équipements requis -->
               <HBox spacing="12" alignment="CENTER_LEFT">
                  <CheckBox fx:id="filtreEquipCheck" text="Équipements requis :" style="-fx-text-fill: #1A1F3A;" />
               </HBox>
               <ListView fx:id="equipementsList" prefHeight="120" minHeight="100" 
                         style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
         
               <!-- Alternatives en cas d'échec -->
               <VBox fx:id="alternativesPane" spacing="5" visible="false" managed="false">
                  <Label text="⚠️ Alternatives proposées :"
                         style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #F4A261;" />
                  <ComboBox fx:id="alternativesCombo" prefWidth="400"
                            promptText="Choisir une alternative..." 
                            style="-fx-background-color: white; -fx-border-color: #E8EBFF; -fx-border-radius: 5;" />
               </VBox>
            </VBox>
         </VBox>
      
         <!-- Message erreur -->
         <Label fx:id="messageLabel" visible="false" managed="false"
                wrapText="true"
                style="-fx-text-fill: #E53E3E; -fx-font-weight: bold;
                       -fx-background-color: #F8F9FF; -fx-padding: 7 12; -fx-background-radius: 6;" />
      
         <!-- Boutons -->
         <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="annulerDialogueButton" text="Annuler"
                    style="-fx-background-color: #E8EBFF; -fx-text-fill: #1A1F3A;
                           -fx-background-radius: 7; -fx-padding: 8 18; -fx-font-weight: bold; -fx-cursor: hand;" />
            <Button fx:id="confirmerCreneauButton" text="✓ Confirmer"
                    style="-fx-background-color: #2DC653; -fx-text-fill: white;
                           -fx-background-radius: 7; -fx-padding: 8 18; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" />
         </HBox>
      
      </VBox>
   </content>
</ScrollPane>