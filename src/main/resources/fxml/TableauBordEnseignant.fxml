<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="820" prefWidth="1240"
            style="-fx-background-color:#FBF8F3;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.TableauBordEnseignantControleur">
   
   <!-- TOP HEADER -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14" minHeight="58" prefHeight="58"
            style="-fx-background-color:#3D261A; -fx-padding:0 24; -fx-border-color:transparent transparent #D39A43 transparent; -fx-border-width:0 0 2 0;">
         <ImageView fitHeight="36" fitWidth="65" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../images/logo.png" />
            </image>
         </ImageView>
         <VBox alignment="CENTER_LEFT" spacing="1">
            <Label text="Mon Espace Enseignant"
                   style="-fx-font-size:16px; -fx-font-weight:900; -fx-text-fill:#FBF8F3; -fx-font-family:'Segoe UI';"/>
            <Label text="UNIV-SCHEDULER - Université Iba Der Thiam de Thiès"
                   style="-fx-font-size:10px; -fx-text-fill:#D39A43; -fx-font-weight:600;"/>
         </VBox>
         <Region HBox.hgrow="ALWAYS"/>
         <Label fx:id="utilisateurLabel" text=""
                style="-fx-text-fill:#FBF8F3; -fx-font-size:12px; -fx-font-weight:700;"/>
         <Label fx:id="roleLabel" text=""
                style="-fx-text-fill:#E6C387; -fx-font-size:11px;"/>
         <Label fx:id="dateLabel" text=""
                style="-fx-text-fill:rgba(251,248,243,0.65); -fx-font-size:11px;"/>
         <Button fx:id="profilButton" text="Profil"
                 style="-fx-background-color:transparent; -fx-text-fill:#FBF8F3;
                        -fx-border-color:rgba(211,154,67,0.5); -fx-border-width:1;
                        -fx-border-radius:8; -fx-background-radius:8;
                        -fx-padding:6 14; -fx-font-size:12px; -fx-font-weight:600; -fx-cursor:hand;"/>
         <Button fx:id="deconnexionButton" text="Déconnexion"
                 style="-fx-background-color:#9E2A2B; -fx-text-fill:white;
                        -fx-background-radius:8; -fx-padding:6 14;
                        -fx-font-size:12px; -fx-font-weight:700; -fx-cursor:hand;"/>
      </HBox>
   </top>

   <!-- SIDEBAR GAUCHE FIXE (NE S'EFFONDRE JAMAIS) -->
   <left>
      <ScrollPane fitToWidth="true" minWidth="240" prefWidth="240" maxWidth="250"
                  style="-fx-background-color:#3D261A; -fx-background:#3D261A; -fx-border-color:transparent #543310 transparent transparent; -fx-border-width:0 1 0 0;"
                  hbarPolicy="NEVER">
         <content>
            <VBox spacing="6" style="-fx-padding:16 12; -fx-background-color:#3D261A;">
               <Label text="NAVIGATION" style="-fx-text-fill:#D39A43; -fx-font-size:10px; -fx-font-weight:800; -fx-padding:0 8 6 8;"/>
               
               <Button fx:id="sidebarEdtBtn" text="📅 Mon emploi du temps"
                       style="-fx-background-color:transparent; -fx-text-fill:#FBF8F3; -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
               <Button fx:id="sidebarCoursBtn" text="📚 Mes cours"
                       style="-fx-background-color:transparent; -fx-text-fill:rgba(251,248,243,0.75); -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
               <Button fx:id="sidebarPlanningBtn" text="📋 Planning détaillé"
                       style="-fx-background-color:transparent; -fx-text-fill:rgba(251,248,243,0.75); -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
               <Button fx:id="sidebarRechercheBtn" text="🔍 Rechercher une salle"
                       style="-fx-background-color:transparent; -fx-text-fill:rgba(251,248,243,0.75); -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
               <Button fx:id="sidebarCarteBtn" text="🗺️ Carte interactive"
                       style="-fx-background-color:transparent; -fx-text-fill:rgba(251,248,243,0.75); -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
               <Button fx:id="sidebarCoursReportesBtn" text="🔄 Cours reportés"
                       style="-fx-background-color:transparent; -fx-text-fill:rgba(251,248,243,0.75); -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
               <Button fx:id="sidebarSignalementBtn" text="⚠️ Signaler un problème"
                       style="-fx-background-color:transparent; -fx-text-fill:rgba(251,248,243,0.75); -fx-alignment:CENTER_LEFT;
                              -fx-padding:10 14; -fx-font-size:13px; -fx-font-weight:600; -fx-background-radius:8;
                              -fx-cursor:hand;" maxWidth="Infinity"/>
            </VBox>
         </content>
      </ScrollPane>
   </left>

   <!-- CONTENU CENTRAL -->
   <center>
      <StackPane fx:id="contenuPrincipal" style="-fx-background-color:#FBF8F3;">
         <VBox style="-fx-background-color:#FBF8F3;">
            <!-- Bande résumé enseignant -->
            <HBox spacing="20" style="-fx-background-color:white; -fx-padding:14 24; -fx-border-color:transparent transparent #E6DCCD transparent; -fx-border-width:0 0 1 0;">
               <VBox spacing="2">
                  <Label text="Bienvenue" style="-fx-font-size:11px; -fx-text-fill:#8C6D58; -fx-font-weight:600;"/>
                  <Label fx:id="bienvenueLabel" text="" style="-fx-font-size:15px; -fx-font-weight:800; -fx-text-fill:#3D261A;"/>
               </VBox>
               <VBox spacing="2">
                  <Label text="Matricule" style="-fx-font-size:11px; -fx-text-fill:#8C6D58; -fx-font-weight:600;"/>
                  <Label fx:id="matriculeLabel" text="-" style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#6B4226;"/>
               </VBox>
               <Region HBox.hgrow="ALWAYS"/>
               <VBox spacing="2" alignment="CENTER_RIGHT">
                  <Label text="Cours assignés" style="-fx-font-size:11px; -fx-text-fill:#8C6D58; -fx-font-weight:600;"/>
                  <Label fx:id="totalCoursLabel" text="0" style="-fx-font-size:18px; -fx-font-weight:900; -fx-text-fill:#6B4226;"/>
               </VBox>
               <VBox spacing="2" alignment="CENTER_RIGHT">
                  <Label text="Heures totales" style="-fx-font-size:11px; -fx-text-fill:#8C6D58; -fx-font-weight:600;"/>
                  <Label fx:id="heuresTotalesLabel" text="0h" style="-fx-font-size:18px; -fx-font-weight:900; -fx-text-fill:#2E7D32;"/>
               </VBox>
               <VBox spacing="2" alignment="CENTER_RIGHT">
                  <Label text="Prochain cours" style="-fx-font-size:11px; -fx-text-fill:#8C6D58; -fx-font-weight:600;"/>
                  <Label fx:id="prochainCoursLabel" text="-" style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#D39A43;"/>
               </VBox>
            </HBox>
            
            <HBox fx:id="legendContainer" spacing="25" alignment="CENTER_LEFT"
                  style="-fx-background-color:#F5EFEB; -fx-padding:8 24; -fx-border-color:transparent transparent #E6DCCD transparent; -fx-border-width:0 0 1 0;"/>
            
            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab text="Mon emploi du temps">
                     <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color:#FBF8F3; -fx-background:#FBF8F3;" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox spacing="14" style="-fx-padding:16;">
                                 <VBox spacing="10" style="-fx-background-color:white; -fx-padding:14 18; -fx-background-radius:12; -fx-border-color:#E6DCCD; -fx-border-width:1; -fx-border-radius:12;">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                       <Label text="📅 Période :" style="-fx-font-weight:bold; -fx-text-fill:#3D261A;"/>
                                       <DatePicker fx:id="dateDebutPicker" prefWidth="135"/>
                                       <Label text="au :" style="-fx-text-fill:#6B4226;"/>
                                       <DatePicker fx:id="dateFinPicker" prefWidth="135"/>
                                       <Button fx:id="aujourdhuiButton" text="Aujourd'hui"
                                               style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 12; -fx-font-weight:700; -fx-cursor:hand;"/>
                                       <Button fx:id="semaineButton" text="Semaine"
                                               style="-fx-background-color:#6B4226; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 12; -fx-font-weight:700; -fx-cursor:hand;"/>
                                       <Button fx:id="rechercherButton" text="🔍 Rechercher"
                                               style="-fx-background-color:#3D261A; -fx-text-fill:#FBF8F3; -fx-background-radius:8; -fx-padding:7 14; -fx-font-weight:700; -fx-cursor:hand;"/>
                                       <Region HBox.hgrow="ALWAYS"/>
                                       <Button fx:id="exporterPDFButton" text="📄 PDF"
                                               style="-fx-background-color:#9E2A2B; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 12; -fx-font-weight:700; -fx-cursor:hand;"/>
                                       <Button fx:id="exporterExcelButton" text="📊 Excel"
                                               style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 12; -fx-font-weight:700; -fx-cursor:hand;"/>
                                       <Button fx:id="reserverSalleButton" text="+ Réserver"
                                               style="-fx-background-color:#D39A43; -fx-text-fill:#3D261A; -fx-background-radius:8; -fx-padding:7 12; -fx-font-weight:800; -fx-cursor:hand;"/>
                                       <ProgressIndicator fx:id="chargementIndicator" maxWidth="24" maxHeight="24" visible="false"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                       <Label text="🔍 Filtrer :" style="-fx-font-weight:bold; -fx-text-fill:#3D261A;"/>
                                       <Label text="Classe :" style="-fx-text-fill:#8C6D58; -fx-font-size:12px;"/>
                                       <ComboBox fx:id="filtreClasseCombo" prefWidth="200" promptText="Toutes les classes"/>
                                       <Label text="UFR :" style="-fx-text-fill:#8C6D58; -fx-font-size:12px;"/>
                                       <ComboBox fx:id="filtreUfrCombo" prefWidth="180" promptText="Toutes les UFR"/>
                                       <Button fx:id="reinitFiltresButton" text="↺ Réinitialiser"
                                               style="-fx-background-color:#8C6D58; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:5 10; -fx-font-size:11px; -fx-cursor:hand;"/>
                                       <Region HBox.hgrow="ALWAYS"/>
                                       <Label fx:id="infoFiltreLabel" text="" style="-fx-text-fill:#6B4226; -fx-font-size:11px; -fx-font-weight:bold;"/>
                                    </HBox>
                                 </VBox>
                                 
                                 <ScrollPane fitToWidth="false" minHeight="500" prefHeight="580"
                                             style="-fx-background-color:transparent; -fx-background:transparent;"
                                             hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                                    <content>
                                       <GridPane fx:id="emploiTempsGrid" hgap="2" vgap="2"
                                                 style="-fx-background-color:#E6DCCD; -fx-padding:2; -fx-background-radius:8;"/>
                                    </content>
                                 </ScrollPane>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </content>
                  </Tab>
                  
                  <Tab text="Mes cours">
                     <content>
                        <VBox spacing="14" style="-fx-padding:16; -fx-background-color:#FBF8F3;">
                           <VBox spacing="12" style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:12; -fx-border-color:#E6DCCD; -fx-border-width:1; -fx-border-radius:12;">
                              <HBox spacing="10" alignment="CENTER_LEFT">
                                 <Label text="Mes cours assignés" style="-fx-font-size:15px; -fx-font-weight:800; -fx-text-fill:#3D261A;"/>
                                 <Region HBox.hgrow="ALWAYS"/>
                                 <TextField fx:id="rechercheCoursField" promptText="Rechercher par matière, classe..." prefWidth="280"
                                            style="-fx-padding:7 12; -fx-background-radius:8; -fx-border-color:#D0C5B8; -fx-border-width:1.5; -fx-border-radius:8;"/>
                                 <Button fx:id="actualiserCoursButton" text="Actualiser"
                                         style="-fx-background-color:#6B4226; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 14; -fx-font-weight:700; -fx-cursor:hand;"/>
                                 <Label fx:id="totalCoursCountLabel" text="0 cours" style="-fx-text-fill:#8C6D58; -fx-font-weight:600;"/>
                              </HBox>
                              <ListView fx:id="mesCoursList" prefHeight="440" VBox.vgrow="ALWAYS"/>
                           </VBox>
                        </VBox>
                     </content>
                  </Tab>
                  
                  <Tab text="Planning détaillé">
                     <content>
                        <VBox spacing="14" style="-fx-padding:16; -fx-background-color:#FBF8F3;">
                           <VBox spacing="12" style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:12; -fx-border-color:#E6DCCD; -fx-border-width:1; -fx-border-radius:12;">
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <Label text="Planning détaillé" style="-fx-font-size:15px; -fx-font-weight:800; -fx-text-fill:#3D261A;"/>
                                 <Region HBox.hgrow="ALWAYS"/>
                                 <Label text="Du :" style="-fx-text-fill:#6B4226;"/><DatePicker fx:id="planningDateDebut" prefWidth="135"/>
                                 <Label text="au :" style="-fx-text-fill:#6B4226;"/><DatePicker fx:id="planningDateFin" prefWidth="135"/>
                                 <Button fx:id="rechercherPlanningButton" text="Rechercher"
                                         style="-fx-background-color:#6B4226; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 14; -fx-font-weight:700; -fx-cursor:hand;"/>
                                 <Button fx:id="exporterPlanningPDFButton" text="Export PDF"
                                         style="-fx-background-color:#9E2A2B; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:7 12; -fx-font-weight:700; -fx-cursor:hand;"/>
                              </HBox>
                              <TableView fx:id="planningTableView" VBox.vgrow="ALWAYS" prefHeight="460">
                                 <columns>
                                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="120" minWidth="100"/>
                                    <TableColumn fx:id="horaireColumn" text="Horaire" prefWidth="140" minWidth="120"/>
                                    <TableColumn fx:id="coursColumn" text="Cours" prefWidth="200" minWidth="160"/>
                                    <TableColumn fx:id="classeColumn" text="Classe" prefWidth="140" minWidth="120"/>
                                    <TableColumn fx:id="salleColumn" text="Salle" prefWidth="100" minWidth="90"/>
                                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="220" minWidth="200"/>
                                 </columns>
                                 <placeholder><Label text="Sélectionnez une période et cliquez Rechercher" style="-fx-text-fill:#8C6D58;"/></placeholder>
                              </TableView>
                           </VBox>
                        </VBox>
                     </content>
                  </Tab>
                  
                  <Tab fx:id="ongletRecherche" text="Recherche">
                     <content><fx:include source="Recherche.fxml"/></content>
                  </Tab>
                  <Tab text="Carte">
                     <content><fx:include source="Carte.fxml"/></content>
                  </Tab>
                  <Tab text="⚠️ Signalement">
                     <content><fx:include source="Signalement.fxml"/></content>
                  </Tab>
               </tabs>
            </TabPane>
         </VBox>
      </StackPane>
   </center>
</BorderPane>