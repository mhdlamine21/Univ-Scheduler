<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.InscriptionControleur">
   
   <content>
      <BorderPane minHeight="680.0" minWidth="550.0" prefHeight="760.0" prefWidth="640.0"
                  style="-fx-background-color: #FBF8F3;">
         
         <top>
            <HBox alignment="CENTER_LEFT" spacing="15.0"
                  style="-fx-background-color: #3D261A; -fx-padding: 14 25; -fx-border-color: transparent transparent #D39A43 transparent; -fx-border-width: 0 0 2 0;">
               <ImageView fitHeight="36.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../images/logo.png" />
                  </image>
               </ImageView>
               <VBox alignment="CENTER_LEFT" spacing="1">
                  <Label text="Demande d'inscription" textFill="#FBF8F3" style="-fx-font-size: 17px; -fx-font-weight: 800;" />
                  <Label text="UNIV-SCHEDULER - UIDT" textFill="#D39A43" style="-fx-font-size: 10px; -fx-font-weight: 600;" />
               </VBox>
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="dateLabel" text="" textFill="#E6C387" style="-fx-font-size: 11px;" />
               <Button fx:id="retourButton" text="Retour"
                       style="-fx-background-color: rgba(251,248,243,0.15); -fx-text-fill: #FBF8F3; -fx-background-radius: 8; -fx-padding: 7 16; -fx-font-weight: 600; -fx-cursor: hand;" />
            </HBox>
         </top>
         
         <center>
            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1;" VBox.vgrow="ALWAYS" minHeight="600">
                     
                     <!-- SECTION RADIO BUTTONS -->
                     <VBox spacing="10.0">
                        <Label text="Type de profil :" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                        
                        <HBox spacing="30.0" alignment="CENTER_LEFT">
                           <RadioButton fx:id="etudiantRadio" text="Étudiant" selected="true" style="-fx-font-size: 13px; -fx-font-weight: 600;">
                              <toggleGroup>
                                 <ToggleGroup fx:id="roleGroup" />
                              </toggleGroup>
                           </RadioButton>
                           <RadioButton fx:id="enseignantRadio" text="Enseignant" style="-fx-font-size: 13px; -fx-font-weight: 600;" toggleGroup="$roleGroup" />
                           <RadioButton fx:id="gestionnaireRadio" text="Gestionnaire" style="-fx-font-size: 13px; -fx-font-weight: 600;" toggleGroup="$roleGroup" />
                        </HBox>
                     </VBox>
                     
                     <Separator style="-fx-opacity: 0.6;" />
                     
                     <!-- INFORMATIONS PERSONNELLES -->
                     <VBox spacing="12.0">
                        <Label text="Informations personnelles" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                        
                        <TextField fx:id="nomField" promptText="Nom *"
                                   style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-width: 1.5; -fx-border-radius: 8;" />
                        <TextField fx:id="prenomField" promptText="Prénom *"
                                   style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-width: 1.5; -fx-border-radius: 8;" />
                        <TextField fx:id="emailField" promptText="Adresse email institutionnelle *"
                                   style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-width: 1.5; -fx-border-radius: 8;" />
                     </VBox>
                     
                     <!-- PANEL ÉTUDIANT -->
                     <VBox fx:id="etudiantPanel" spacing="12.0" managed="true" visible="true">
                        <Label text="Informations de scolarité" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                        
                        <TextField fx:id="numeroEtudiantField" promptText="Numéro étudiant / Matricule *"
                                   style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-width: 1.5; -fx-border-radius: 8;" />
                        
                        <ComboBox fx:id="ufrComboBox" promptText="Sélectionner votre UFR *" maxWidth="Infinity"
                                  style="-fx-padding: 6; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
                        <Label fx:id="ufrInfoLabel" style="-fx-font-size: 11px; -fx-text-fill: #8C6D58;" />
                        
                        <ComboBox fx:id="classeComboBox" promptText="Sélectionner votre classe *" maxWidth="Infinity"
                                  style="-fx-padding: 6; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
                        
                        <CheckBox fx:id="responsableClasseCheckBox" text="⭐ Responsable de classe (Délégué de promotion)"
                                  style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #3D261A; -fx-padding: 4 0;" />
                        <Label text="Cochez cette case si vous êtes le délégué officiel de votre classe (autorise la réservation de salles)."
                               style="-fx-font-size: 11px; -fx-text-fill: #8C6D58; -fx-padding: 0 0 0 24;" wrapText="true" />
                     </VBox>
                     
                     <!-- PANEL ENSEIGNANT -->
                     <VBox fx:id="enseignantPanel" spacing="12.0" managed="false" visible="false">
                        <Label text="Informations académiques" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                        
                        <TextField fx:id="matriculeField" promptText="Matricule enseignant *"
                                   style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-width: 1.5; -fx-border-radius: 8;" />
                        
                        <ComboBox fx:id="gradeComboBox" promptText="Grade universitaire *" maxWidth="Infinity"
                                  style="-fx-padding: 6; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
                        <Label fx:id="gradeInfoLabel" style="-fx-font-size: 11px; -fx-text-fill: #8C6D58;" />
                     </VBox>
                     
                     <!-- PANEL GESTIONNAIRE -->
                     <VBox fx:id="gestionnairePanel" spacing="10.0" managed="false" visible="false">
                        <Label text="Informations administratives" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                        <Label text="La demande sera soumise pour validation à l'administrateur système." style="-fx-text-fill: #8C6D58; -fx-font-style: italic;" />
                     </VBox>
                     
                     <!-- MESSAGE ERREUR / STATUT -->
                     <Label fx:id="messageLabel" style="-fx-text-fill: #9E2A2B; -fx-font-weight: bold;" visible="false" wrapText="true" />
                     
                     <!-- INDICATEUR CHARGEMENT -->
                     <ProgressIndicator fx:id="loadingIndicator" maxWidth="36.0" maxHeight="36.0" visible="false" />
                     
                     <!-- BOUTONS -->
                     <HBox alignment="CENTER" spacing="15.0">
                        <Button fx:id="annulerButton" text="Annuler" prefWidth="130.0" prefHeight="40.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #6B4226; -fx-border-color: #6B4226; -fx-border-width: 1.5px; -fx-border-radius: 8; -fx-font-weight: 700; -fx-cursor: hand;" />
                        <Button fx:id="inscrireButton" text="Envoyer la demande" defaultButton="true" onAction="#handleInscription" prefWidth="180.0" prefHeight="40.0"
                                style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: 800; -fx-cursor: hand;" />
                     </HBox>
                  </VBox>
               </content>
            </ScrollPane>
         </center>
      </BorderPane>
   </content>
</ScrollPane>