<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.GestionUtilisateursControleur">
   
   <content>
      <VBox spacing="20.0" style="-fx-background-color: #FBF8F3; -fx-padding: 24;" VBox.vgrow="ALWAYS">
         
         <!-- En-tête -->
         <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="👥 Gestion des Comptes Utilisateurs"
                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #3D261A;" />
            <Region HBox.hgrow="ALWAYS" />
         </HBox>
         
         <!-- STATISTIQUES HARMONISÉES -->
         <HBox spacing="14.0" style="-fx-background-color: white; -fx-padding: 16 20; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(61,38,26,0.06), 6, 0, 0, 2);">
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Total" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="totalUtilisateursLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #6B4226;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Admins" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="adminsLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #3D261A;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Gestionnaires" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="gestionnairesLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #9E5D32;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Enseignants" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="enseignantsLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #C89658;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Étudiants" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="etudiantsLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #D39A43;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Normaux" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="etudiantsNormauxLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #7A665A;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="Délégués" style="-fx-font-size: 11px; -fx-text-fill: #7A665A; -fx-font-weight: 700;" />
               <Label fx:id="etudiantsResponsablesLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #2D6A4F;" />
            </VBox>
            <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
               <Label text="En attente" style="-fx-font-size: 11px; -fx-text-fill: #A42424; -fx-font-weight: 700;" />
               <Label fx:id="enAttenteLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #A42424;" />
            </VBox>
         </HBox>
         
         <!-- Filtres et Tableau -->
         <VBox spacing="14.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1;">
            
            <HBox spacing="12.0" alignment="CENTER_LEFT" style="-fx-background-color: #F5EFEB; -fx-padding: 10 14; -fx-background-radius: 8;">
               <Label text="Filtres :" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
               <ComboBox fx:id="filtreRoleCombo" promptText="Rôle" prefWidth="120.0" />
               <ComboBox fx:id="filtreStatutCombo" promptText="Statut" prefWidth="110.0" />
               <ComboBox fx:id="filtreUfrCombo" promptText="UFR" prefWidth="150.0" />
               <TextField fx:id="rechercheField" promptText="Nom, prénom ou email..." HBox.hgrow="ALWAYS"
                          style="-fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #D0C5B8; -fx-border-radius: 6;" />
               <Button fx:id="rechercherButton" text="Filtrer"
                       style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-weight: 700; -fx-cursor: hand;" />
               <Button fx:id="reinitialiserButton" text="↺ Réinitialiser"
                       style="-fx-background-color: #8C6D58; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" />
               <Region HBox.hgrow="ALWAYS" />
               <Button text="➕ Nouvel utilisateur" onAction="#handleAjouterUtilisateur"
                       style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-weight: 700; -fx-cursor: hand;" />
               <Button text="📋 Demandes" onAction="#handleVoirDemandes"
                       style="-fx-background-color: #D39A43; -fx-text-fill: #3D261A; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-weight: 700; -fx-cursor: hand;" />
            </HBox>
            
            <TableView fx:id="utilisateurTable" minHeight="500" prefHeight="750" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idColumn" text="ID" minWidth="45" prefWidth="50" />
                  <TableColumn fx:id="nomColumn" text="Nom" minWidth="100" prefWidth="120" />
                  <TableColumn fx:id="prenomColumn" text="Prénom" minWidth="100" prefWidth="120" />
                  <TableColumn fx:id="emailColumn" text="Email" minWidth="180" prefWidth="220" />
                  <TableColumn fx:id="roleColumn" text="Rôle" minWidth="90" prefWidth="110" />
                  <TableColumn fx:id="ufrColumn" text="UFR" minWidth="110" prefWidth="130" />
                  <TableColumn fx:id="classeColumn" text="Classe" minWidth="120" prefWidth="140" />
                  <TableColumn fx:id="typeEtudiantColumn" text="Statut étudiant" minWidth="110" prefWidth="130" />
                  <TableColumn fx:id="statutColumn" text="Statut" minWidth="85" prefWidth="100" />
                  <TableColumn fx:id="dateColumn" text="Créé le" minWidth="95" prefWidth="110" />
                  <TableColumn fx:id="actionsColumn" text="Actions" minWidth="260" prefWidth="300" />
               </columns>
               <placeholder>
                  <Label text="Aucun utilisateur répertorié" style="-fx-font-size: 14px; -fx-text-fill: #8C6D58;" />
               </placeholder>
            </TableView>
         </VBox>
         
         <ProgressIndicator fx:id="chargementIndicator" maxWidth="40.0" maxHeight="40.0" visible="false" />
      </VBox>
   </content>
</ScrollPane>