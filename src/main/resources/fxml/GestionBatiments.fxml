<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.GestionBatimentsControleur">
   
   <content>
      <VBox spacing="20.0" style="-fx-background-color: #FBF8F3; -fx-padding: 24;">
         
         <!-- Formulaire -->
         <VBox spacing="16.0" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(61,38,26,0.06), 10, 0, 0, 2);">
            <Label style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" text="🏛️ Informations du bâtiment" />
            
            <GridPane hgap="15.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               
               <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="UFR :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <ComboBox fx:id="ufrCombo" promptText="Sélectionner une UFR" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"
                         style="-fx-padding: 5; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
               
               <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="Nom :" GridPane.columnIndex="2" GridPane.rowIndex="0" />
               <TextField fx:id="nomField" promptText="Nom du bâtiment" GridPane.columnIndex="3" GridPane.rowIndex="0"
                          style="-fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
               
               <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="Localisation :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <TextField fx:id="localisationField" promptText="Localisation (ex: Campus 2)" GridPane.columnIndex="1" GridPane.rowIndex="1"
                          style="-fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
               
               <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="Nombre d'étages :" GridPane.columnIndex="2" GridPane.rowIndex="1" />
               <Spinner fx:id="etagesSpinner" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </GridPane>
            
            <TitledPane expanded="false" text="Indisponibilité temporaire / Travaux">
               <content>
                  <VBox spacing="10.0" style="-fx-padding: 10;">
                     <GridPane hgap="12.0" vgap="10.0">
                        <columnConstraints>
                           <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                           <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="Motif :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextArea fx:id="motifArea" prefRowCount="2" promptText="Raison de l'indisponibilité" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="Date début :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dateDebutPicker" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="Date fin :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <DatePicker fx:id="dateFinPicker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </GridPane>
                  </VBox>
               </content>
            </TitledPane>
            
            <Label fx:id="messageLabel" style="-fx-text-fill: #9E2A2B; -fx-font-weight: bold;" visible="false" wrapText="true" />
            
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <Button fx:id="annulerButton" style="-fx-background-color: #8C6D58; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 18; -fx-font-weight: 600; -fx-cursor: hand;" text="Annuler" />
               <Button fx:id="ajouterButton" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 800; -fx-cursor: hand;" text="Ajouter le bâtiment" />
               <Button fx:id="modifierButton" disable="true" style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 800; -fx-cursor: hand;" text="Modifier" />
               <Button fx:id="supprimerButton" disable="true" style="-fx-background-color: #9E2A2B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 800; -fx-cursor: hand;" text="Supprimer" />
               <Button fx:id="rendreIndisponibleButton" disable="true" style="-fx-background-color: #D39A43; -fx-text-fill: #3D261A; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 700; -fx-cursor: hand;" text="Marquer indisponible" />
               <Button fx:id="rendreDisponibleButton" disable="true" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 700; -fx-cursor: hand;" text="Rendre disponible" />
            </HBox>
         </VBox>
         
         <!-- Filtres -->
         <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F5EFEB; -fx-padding: 10 14; -fx-background-radius: 8;">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" text="🔍 Filtres :" />
            <TextField fx:id="rechercheField" prefWidth="180" promptText="Nom du bâtiment..."
                       style="-fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #D0C5B8; -fx-border-radius: 6;" />
            <ComboBox fx:id="filtreUfrCombo" prefWidth="150" promptText="Toutes les UFR" />
            <ComboBox fx:id="filtreStatutCombo" prefWidth="130" promptText="Tous les statuts" />
            <Button fx:id="rechercherButton" style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 16; -fx-font-weight: 700; -fx-cursor: hand;" text="Filtrer" />
            <Button fx:id="reinitialiserButton" style="-fx-background-color: #8C6D58; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="↺ Réinitialiser" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="rafraichirButton" style="-fx-background-color: #D39A43; -fx-text-fill: #3D261A; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-weight: 700; -fx-cursor: hand;" text="🔄 Rafraîchir" />
         </HBox>
         
         <!-- Tableau -->
         <VBox spacing="8.0" VBox.vgrow="ALWAYS" style="-fx-padding: 14; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" text="Liste des bâtiments répertoriés" />
            
            <TableView fx:id="batimentTable" prefHeight="550" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
                  <TableColumn fx:id="nomColumn" prefWidth="200" text="Nom du bâtiment" />
                  <TableColumn fx:id="localisationColumn" prefWidth="160" text="Localisation" />
                  <TableColumn fx:id="etagesColumn" prefWidth="80" text="Étages" />
                  <TableColumn fx:id="ufrColumn" prefWidth="200" text="UFR de rattachement" />
                  <TableColumn fx:id="statutColumn" prefWidth="110" text="Statut" />
                  <TableColumn fx:id="actionsColumn" prefWidth="180" text="Actions" />
               </columns>
               <placeholder>
                  <Label style="-fx-font-size: 14px; -fx-text-fill: #8C6D58;" text="Aucun bâtiment répertorié" />
               </placeholder>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT">
               <Label fx:id="totalBatimentsLabel" style="-fx-font-size: 12px; -fx-text-fill: #6B4226; -fx-font-weight: bold;" text="0 bâtiment(s)" />
            </HBox>
         </VBox>
         
         <ProgressIndicator fx:id="chargementIndicator" maxHeight="50.0" maxWidth="50.0" visible="false" />
      </VBox>
   </content>
</ScrollPane>