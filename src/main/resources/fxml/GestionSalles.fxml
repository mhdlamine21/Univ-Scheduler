<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.GestionSallesControleur">
   
   <content>
      <VBox spacing="20.0" style="-fx-background-color: #FBF8F3; -fx-padding: 24;" VBox.vgrow="ALWAYS">
         
         <!-- En-tête -->
         <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🏫 Gestion des Salles et Espaces Pédagogiques"
                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #3D261A;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="totalSallesLabel" text="0 salle(s)" style="-fx-font-weight: bold; -fx-text-fill: #6B4226;" />
            <Button fx:id="rafraichirButton" text="🔄 Rafraîchir"
                    style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 700; -fx-cursor: hand;" />
         </HBox>
         
         <!-- Formulaire principal -->
         <VBox spacing="16.0" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(61,38,26,0.06), 10, 0, 0, 2);">
            
            <Label text="Informations de la salle" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
            
            <HBox spacing="24" alignment="TOP_LEFT">
               <!-- Zone Photo de la Salle -->
               <VBox spacing="8" alignment="CENTER" minWidth="130" prefWidth="130">
                  <StackPane prefWidth="120" prefHeight="100"
                             style="-fx-background-color: #F5EFEB; -fx-background-radius: 10; -fx-border-color: #D39A43; -fx-border-width: 1.5; -fx-border-radius: 10;">
                     <ImageView fx:id="photoPreview" fitHeight="90" fitWidth="110" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/logo.png" />
                        </image>
                     </ImageView>
                  </StackPane>
                  <Button fx:id="choisirPhotoButton" text="📷 Photo salle"
                          style="-fx-background-color: #D39A43; -fx-text-fill: #3D261A; -fx-background-radius: 6; -fx-padding: 5 10; -fx-font-size: 11px; -fx-font-weight: 700; -fx-cursor: hand;" />
                  <Button fx:id="supprimerPhotoButton" text="✕ Supprimer"
                          style="-fx-background-color: transparent; -fx-text-fill: #9E2A2B; -fx-font-size: 10px; -fx-cursor: hand;" visible="false" />
               </VBox>
               
               <GridPane hgap="15.0" vgap="12.0" HBox.hgrow="ALWAYS">
                  <columnConstraints>
                     <ColumnConstraints hgrow="NEVER" minWidth="110.0" />
                     <ColumnConstraints hgrow="ALWAYS" />
                     <ColumnConstraints hgrow="NEVER" minWidth="110.0" />
                     <ColumnConstraints hgrow="ALWAYS" />
                  </columnConstraints>
                  
                  <Label text="Numéro / Code :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                  <TextField fx:id="numeroField" promptText="ex: A101, Amphi A..." GridPane.columnIndex="1" GridPane.rowIndex="0"
                             style="-fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
                  
                  <Label text="Bâtiment :" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                  <ComboBox fx:id="batimentCombo" promptText="Sélectionner un bâtiment" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"
                            style="-fx-padding: 5; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
                  
                  <Label text="Capacité :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                  <Spinner fx:id="capaciteSpinner" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Type de salle :" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                  <ComboBox fx:id="typeCombo" promptText="Type de salle" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"
                            style="-fx-padding: 5; -fx-background-radius: 8; -fx-border-color: #E6DCCD; -fx-border-radius: 8;" />
                  
                  <Label text="Étage :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                  <Spinner fx:id="etageSpinner" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </GridPane>
            </HBox>
            
            <TitledPane text="Indisponibilité temporaire / Maintenance" expanded="false">
               <content>
                  <GridPane hgap="15.0" vgap="12.0" style="-fx-padding: 12;">
                     <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     
                     <Label text="Motif :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                     <TextArea fx:id="motifArea" promptText="Raison de l'indisponibilité (travaux, panne projecteur...)" prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     
                     <Label text="Date début :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                     <DatePicker fx:id="dateDebutPicker" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     
                     <Label text="Date fin :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                     <DatePicker fx:id="dateFinPicker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  </GridPane>
               </content>
            </TitledPane>
            
            <Label fx:id="messageLabel" style="-fx-text-fill: #9E2A2B; -fx-font-weight: bold;" visible="false" wrapText="true" />
            
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <Button fx:id="annulerButton" text="Annuler"
                       style="-fx-background-color: #8C6D58; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 18; -fx-font-weight: 600; -fx-cursor: hand;" />
               <Button fx:id="ajouterButton" text="Ajouter la salle"
                       style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 800; -fx-cursor: hand;" />
               <Button fx:id="modifierButton" text="Modifier" disable="true"
                       style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 800; -fx-cursor: hand;" />
               <Button fx:id="supprimerButton" text="Supprimer" disable="true"
                       style="-fx-background-color: #9E2A2B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 800; -fx-cursor: hand;" />
               <Button fx:id="rendreIndisponibleButton" text="Marquer indisponible" disable="true"
                       style="-fx-background-color: #D39A43; -fx-text-fill: #3D261A; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 700; -fx-cursor: hand;" />
               <Button fx:id="rendreDisponibleButton" text="Rendre disponible" disable="true"
                       style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 700; -fx-cursor: hand;" />
            </HBox>
         </VBox>
         
         <!-- TabPane Liste & Équipements -->
         <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
               
               <!-- Onglet Liste des salles -->
               <Tab text="Liste des salles">
                  <content>
                     <VBox spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-padding: 14; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E6DCCD; -fx-border-width: 1;">
                        
                        <!-- Filtres -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #F5EFEB; -fx-padding: 10 14; -fx-background-radius: 8;">
                           <Label text="🔍 Rechercher :" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                           <TextField fx:id="rechercheField" promptText="Numéro de salle..." prefWidth="180"
                                      style="-fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #D0C5B8; -fx-border-radius: 6;" />
                           
                           <Label text="Type :" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                           <ComboBox fx:id="filtreTypeCombo" prefWidth="110" />
                           
                           <Label text="Statut :" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                           <ComboBox fx:id="filtreStatutCombo" prefWidth="110" />
                           
                           <Label text="Bâtiment :" style="-fx-font-weight: bold; -fx-text-fill: #3D261A;" />
                           <ComboBox fx:id="filtreBatimentCombo" prefWidth="140" />
                           
                           <Button fx:id="rechercherButton" text="Filtrer"
                                   style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-padding: 6 14; -fx-background-radius: 6; -fx-font-weight: 700; -fx-cursor: hand;" />
                           <Button fx:id="reinitialiserButton" text="↺ Réinitialiser"
                                   style="-fx-background-color: #8C6D58; -fx-text-fill: white; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" />
                        </HBox>
                        
                        <!-- Tableau -->
                        <TableView fx:id="salleTable" minHeight="500" prefHeight="700" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="photoColumn" text="Photo" minWidth="75" prefWidth="85" />
                              <TableColumn fx:id="idColumn" text="ID" minWidth="45" prefWidth="55" />
                              <TableColumn fx:id="numeroColumn" text="Numéro" minWidth="90" prefWidth="110" />
                              <TableColumn fx:id="capaciteColumn" text="Capacité" minWidth="75" prefWidth="90" />
                              <TableColumn fx:id="typeColumn" text="Type" minWidth="85" prefWidth="105" />
                              <TableColumn fx:id="batimentColumn" text="Bâtiment" minWidth="130" prefWidth="160" />
                              <TableColumn fx:id="etageColumn" text="Étage" minWidth="65" prefWidth="75" />
                              <TableColumn fx:id="statutColumn" text="Statut" minWidth="95" prefWidth="115" />
                              <TableColumn fx:id="equipementsColumn" text="Équipements" minWidth="140" prefWidth="190" />
                              <TableColumn fx:id="actionsColumn" text="Actions" minWidth="260" prefWidth="290" />
                           </columns>
                           <placeholder>
                              <Label text="Aucune salle répertoriée" style="-fx-font-size: 14px; -fx-text-fill: #8C6D58;" />
                           </placeholder>
                        </TableView>
                     </VBox>
                  </content>
               </Tab>
               
               <!-- Onglet Gestion des équipements -->
               <Tab text="Gestion des équipements">
                  <content>
                     <HBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #E6DCCD; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        
                        <!-- Équipements disponibles -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                           <Label text="Équipements en stock" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                           <ListView fx:id="equipementsDisponiblesList" prefHeight="450" VBox.vgrow="ALWAYS" />
                           <Button fx:id="ajouterEquipementButton" text="Affecter à la salle →" maxWidth="1.7976931348623157E308" 
                                   style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-font-weight: 700; -fx-cursor: hand;" />
                        </VBox>
                        
                        <!-- Équipements de la salle sélectionnée -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                           <Label text="Équipements affectés à la salle" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
                           <ListView fx:id="equipementsSalleList" prefHeight="450" VBox.vgrow="ALWAYS" />
                           <Button fx:id="retirerEquipementButton" text="← Retirer de la salle" maxWidth="1.7976931348623157E308" 
                                   style="-fx-background-color: #9E2A2B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-font-weight: 700; -fx-cursor: hand;" />
                        </VBox>
                        
                     </HBox>
                  </content>
               </Tab>
               
            </tabs>
         </TabPane>
         
         <ProgressIndicator fx:id="chargementIndicator" maxWidth="40.0" maxHeight="40.0" visible="false" />
      </VBox>
   </content>
</ScrollPane>