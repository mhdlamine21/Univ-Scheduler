<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scheduler.controleur.ProfilControleur">
   
   <content>
      <VBox spacing="18.0" style="-fx-background-color: #FBF8F3; -fx-padding: 24;">
         
         <!-- EN-TÊTE MODALE -->
         <HBox alignment="CENTER_LEFT" spacing="12.0"
               style="-fx-background-color: #3D261A; -fx-padding: 14 18; -fx-background-radius: 10;">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
               <Label text="👤 Mon Profil" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #FBF8F3;" />
               <Label fx:id="roleHeaderLabel" text="Université Iba Der Thiam de Thiès" style="-fx-font-size: 11px; -fx-text-fill: #D39A43;" />
            </VBox>
            <Button fx:id="retourButton" text="✕ Fermer" 
                    style="-fx-background-color: rgba(251,248,243,0.15); -fx-text-fill: #FBF8F3; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" 
                    onAction="#handleRetour"/>
         </HBox>
         
         <!-- INFORMATIONS PERSONNELLES -->
         <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #E6DCCD; -fx-border-width: 1;">
            <Label text="Informations personnelles" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
            
            <GridPane hgap="12.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               
               <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="nomField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
               
               <Label text="Prénom :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="prenomField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
               
               <Label text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="emailField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
            </GridPane>
         </VBox>
         
         <!-- PANNEAU ÉTUDIANT -->
         <VBox fx:id="etudiantPane" spacing="12.0" visible="false" managed="false"
               style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #E6DCCD; -fx-border-width: 1;">
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label text="Scolarité &amp; Promotion" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="statutResponsableBadge" text="⭐ Responsable de classe" visible="false" managed="false"
                      style="-fx-background-color: #D39A43; -fx-text-fill: #24160F; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 3 8; -fx-background-radius: 6;" />
            </HBox>
            
            <GridPane hgap="12.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               
               <Label text="N° Étudiant :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="numeroEtudiantField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
               
               <Label text="UFR :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="ufrField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
               
               <Label text="Classe :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="classeField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
            </GridPane>
         </VBox>
         
         <!-- PANNEAU ENSEIGNANT -->
         <VBox fx:id="enseignantPane" spacing="12.0" visible="false" managed="false"
               style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #E6DCCD; -fx-border-width: 1;">
            <Label text="Affiliation Académique" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #3D261A;" />
            
            <GridPane hgap="12.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               
               <Label text="Matricule :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #3D261A; -fx-font-size: 12px;" />
               <TextField fx:id="matriculeField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                          style="-fx-padding: 8 10; -fx-background-color: #F8F6F2; -fx-border-color: #E6DCCD; -fx-border-radius: 6;" />
            </GridPane>
         </VBox>
         
         <!-- MESSAGE NOTIFICATION -->
         <Label fx:id="messageLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;" visible="false" wrapText="true" />
         
         <!-- BOUTONS D'ACTION CONSULTATION -->
         <HBox fx:id="actionsConsultationBox" alignment="CENTER_RIGHT" spacing="12.0">
            <Button fx:id="changerMotDePasseButton" text="🔑 Changer mot de passe" 
                    style="-fx-background-color: #6B4226; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;" />
            <Button fx:id="modifierButton" text="✏️ Modifier" 
                    style="-fx-background-color: #D39A43; -fx-text-fill: #24160F; -fx-background-radius: 6; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" />
         </HBox>
         
         <!-- BOUTONS D'ACTION ÉDITION -->
         <HBox fx:id="actionsEditionBox" alignment="CENTER_RIGHT" spacing="12.0" visible="false" managed="false">
            <Button fx:id="annulerButton" text="Annuler" 
                    style="-fx-background-color: #8C6D58; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;" />
            <Button fx:id="sauvegarderButton" text="💾 Enregistrer" 
                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" />
         </HBox>
         
      </VBox>
   </content>
</ScrollPane>